{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "start": "node dist/index.mjs",
    "dev:bare": "varlock run -- tsx watch src/index.ts",
    "env:generate": "varlock codegen",
    "auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes",
    "db:seed": "varlock run -- tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@starpay/api": "workspace:*",
    "@starpay/auth": "workspace:*",
    "@starpay/contracts": "workspace:*",
    "@starpay/core": "workspace:*",
    "@starpay/db": "workspace:*",
    "@starpay/telegram": "workspace:*",
    "@ton/core": "^0.63.1",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@starpay/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
