# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# AES-256-GCM key for bot tokens and webhook secrets: 32 random bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# @type=string(minLength=44)
ENCRYPTION_KEY=

# Public base URL of this server. Telegram sends bot updates to PUBLIC_API_URL/telegram/webhook/:botId, so it must be HTTPS and reachable from the internet.
# @public @type=url
PUBLIC_API_URL=

# Run background jobs (webhook dispatcher, expiry, sync) in this process.
# @public @type=boolean
WORKER_ENABLED=true

# Comma-separated user IDs allowed into the platform admin (shown on the Settings page).
# @public @required=false
PLATFORM_ADMIN_USER_IDS=

# USD Telegram pays developers per Star; converts payouts to TON.
# @public @required=false
STAR_USD_RATE=0.013

# 24-word mnemonics of dedicated V4R2 hot wallets for automatic TON payouts
# (live → mainnet, test → testnet). Leave empty to process payouts by hand.
# @required=false
TON_PAYOUT_MNEMONIC_LIVE=
# @required=false
TON_PAYOUT_MNEMONIC_TEST=
# @required=false
TONCENTER_API_KEY=
