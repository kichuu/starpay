{
  "name": "starpay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev:bare -F web -F server",
    "dev:alchemy": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev:bare -F server --",
    "db:push": "turbo run db:push -F @starpay/db --",
    "db:studio": "turbo run db:studio -F @starpay/db --",
    "db:generate": "turbo run db:generate -F @starpay/db --",
    "db:migrate": "turbo run db:migrate -F @starpay/db --",
    "deploy": "turbo run deploy -F @starpay/infra --",
    "destroy": "turbo run destroy -F @starpay/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@starpay/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.3.0"
}
