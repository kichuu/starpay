// StarPay domain models. See docs/PLAN.md §3.
//
// `organizationId` references the Better-Auth `organization` table but is kept
// as a plain column: auth.prisma is regenerated by `pnpm auth:generate`, which
// would drop back-relations added there.

enum Mode {
  live
  test
}

enum BotStatus {
  active
  invalid_token
  webhook_error
  disconnected
}

enum ProductType {
  one_time
  subscription
}

enum ProductStatus {
  active
  archived
}

enum OrderStatus {
  created
  pre_checkout
  paid
  refunded
  expired
  failed
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum DeliveryStatus {
  pending
  succeeded
  failed
}

enum EndpointStatus {
  active
  disabled
}

model MerchantSettings {
  organizationId    String   @id
  paySupportText    String   @default("")
  notifyPayment     Boolean  @default(true)
  notifyWebhookFail Boolean  @default(true)
  notifySubCancel   Boolean  @default(true)
  notifyDigest      Boolean  @default(false)
  timezone          String   @default("UTC")
  updatedAt         DateTime @updatedAt

  @@map("merchant_settings")
}

model Bot {
  id               String    @id
  organizationId   String
  mode             Mode
  telegramBotId    BigInt
  username         String
  firstName        String
  tokenEncrypted   String
  tokenLast4       String
  webhookSecret    String
  status           BotStatus @default(active)
  lastUpdateAt     DateTime?
  lastUpdateType   String?
  pendingUpdates   Int       @default(0)
  lastWebhookError String?
  starBalance      Int?
  balanceSyncedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  updates      TelegramUpdate[]
  transactions StarTransaction[]

  @@unique([organizationId, mode])
  @@unique([telegramBotId, mode])
  @@map("bot")
}

model ApiKey {
  id             String    @id
  organizationId String
  mode           Mode
  name           String
  prefix         String
  hash           String    @unique
  last4          String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId, mode])
  @@map("api_key")
}

model Product {
  id             String        @id
  organizationId String
  mode           Mode
  lookupKey      String?
  name           String
  description    String
  photoUrl       String?
  priceStars     Int
  type           ProductType
  periodSeconds  Int?
  status         ProductStatus @default(active)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@unique([organizationId, mode, lookupKey])
  @@index([organizationId, mode, status])
  @@map("product")
}

model Customer {
  id             String    @id
  organizationId String
  mode           Mode
  telegramUserId BigInt
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  totalSpent     Int       @default(0)
  orderCount     Int       @default(0)
  lastPaymentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@unique([organizationId, mode, telegramUserId])
  @@index([organizationId, mode, totalSpent(sort: Desc)])
  @@map("customer")
}

model Order {
  id                String      @id
  organizationId    String
  mode              Mode
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  /// If set, pre-checkout rejects any other payer.
  payerTelegramId   BigInt?
  amountStars       Int
  title             String
  description       String
  status            OrderStatus @default(created)
  failureReason     String?
  merchantReference String?
  metadata          Json        @default("{}")
  invoiceLink       String?
  expiresAt         DateTime
  paidAt            DateTime?
  refundedAt        DateTime?
  apiKeyId          String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  payments     Payment[]
  events       OrderEvent[]
  subscription Subscription?

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([organizationId, mode, status])
  @@index([status, expiresAt])
  @@index([organizationId, mode, merchantReference])
  @@map("order")
}

model Payment {
  id                    String        @id
  organizationId        String
  mode                  Mode
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  /// telegram_payment_charge_id: the idempotency guard for successful_payment.
  telegramChargeId      String        @unique
  amountStars           Int
  isRecurring           Boolean       @default(false)
  isFirstRecurring      Boolean       @default(false)
  subscriptionExpiresAt DateTime?
  refundedAt            DateTime?
  raw                   Json
  createdAt             DateTime      @default(now())

  @@index([orderId])
  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@map("payment")
}

model Subscription {
  id               String             @id
  organizationId   String
  mode             Mode
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id])
  orderId          String             @unique
  order            Order              @relation(fields: [orderId], references: [id])
  /// Charge ID of the first payment; editUserStarSubscription needs it.
  firstChargeId    String
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]

  @@index([organizationId, mode, status])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_event")
}

model TelegramUpdate {
  id           String    @id @default(cuid())
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  updateId     BigInt
  type         String
  payload      Json
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  processingMs Int?
  error        String?

  @@unique([botId, updateId])
  @@index([botId, receivedAt(sort: Desc)])
  @@map("telegram_update")
}

model WebhookEndpoint {
  id                  String         @id
  organizationId      String
  mode                Mode
  url                 String
  description         String?
  /// Empty array = subscribed to every event.
  events              String[]
  status              EndpointStatus @default(active)
  secretEncrypted     String
  prevSecretEncrypted String?
  prevSecretExpiresAt DateTime?
  secretRotatedAt     DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, mode])
  @@map("webhook_endpoint")
}

model WebhookEvent {
  id             String   @id
  organizationId String
  mode           Mode
  type           String
  orderId        String?
  data           Json
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("webhook_event")
}

model WebhookDelivery {
  id             String          @id
  eventId        String
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(5)
  nextAttemptAt  DateTime        @default(now())
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastLatencyMs  Int?
  lastError      String?
  lastResponse   String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  attemptLog WebhookAttempt[]

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("webhook_delivery")
}

model WebhookAttempt {
  id         String          @id @default(cuid())
  deliveryId String
  delivery   WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempt    Int
  statusCode Int?
  latencyMs  Int?
  error      String?
  response   String?
  createdAt  DateTime        @default(now())

  @@index([deliveryId])
  @@map("webhook_attempt")
}

model StarTransaction {
  id           String   @id @default(cuid())
  botId        String
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramTxId String
  /// Signed: positive = incoming, negative = outgoing.
  amount       Int
  kind         String
  orderId      String?
  date         DateTime
  raw          Json

  @@unique([botId, telegramTxId])
  @@index([botId, date(sort: Desc)])
  @@map("star_transaction")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  mode           Mode
  key            String
  requestHash    String
  statusCode     Int
  response       Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, mode, key])
  @@index([createdAt])
  @@map("idempotency_record")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  mode           Mode?
  actorType      String
  actorId        String
  action         String
  targetId       String?
  data           Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_log")
}
