// StarPay domain models. See docs/PLAN.md §3.
//
// `organizationId` references the Better-Auth `organization` table but is kept
// as a plain column: auth.prisma is regenerated by `pnpm auth:generate`, which
// would drop back-relations added there.

enum Mode {
  live
  test
}

enum BotStatus {
  active
  invalid_token
  webhook_error
  disconnected
}

enum ProductType {
  one_time
  subscription
}

enum ProductStatus {
  active
  archived
}

enum OrderStatus {
  created
  pre_checkout
  paid
  refunded
  expired
  failed
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum DeliveryStatus {
  pending
  succeeded
  failed
}

enum EndpointStatus {
  active
  disabled
}

/// direct = paid into the merchant's own bot (no custody, no fee);
/// platform = paid into StarPay's bot and settled through the ledger.
enum Settlement {
  direct
  platform
}

enum LedgerAccountType {
  /// Asset: Stars held in the platform bot's Telegram balance.
  platform_telegram
  /// Asset: value withdrawn from Telegram (via Fragment) into StarPay's TON treasury, in Stars.
  platform_treasury
  /// Revenue: StarPay's fees.
  platform_fees
  /// Liability: merchant earnings still inside the hold period.
  merchant_pending
  /// Liability: merchant earnings they can withdraw.
  merchant_available
  /// Liability: requested payouts not yet sent.
  merchant_payouts
}

enum PayoutStatus {
  requested
  sending
  paid
  failed
  cancelled
}

model MerchantSettings {
  organizationId    String   @id
  /// Overrides the default fee plan when set.
  feePlanId         String?
  feePlan           FeePlan? @relation(fields: [feePlanId], references: [id])
  /// TON wallet for hosted-mode payouts (user-friendly or raw form).
  payoutTonAddress  String?
  paySupportText    String   @default("")
  notifyPayment     Boolean  @default(true)
  notifyWebhookFail Boolean  @default(true)
  notifySubCancel   Boolean  @default(true)
  notifyDigest      Boolean  @default(false)
  timezone          String   @default("UTC")
  updatedAt         DateTime @updatedAt

  @@map("merchant_settings")
}

model Bot {
  id               String    @id
  organizationId   String
  mode             Mode
  telegramBotId    BigInt
  username         String
  firstName        String
  tokenEncrypted   String
  tokenLast4       String
  webhookSecret    String
  status           BotStatus @default(active)
  lastUpdateAt     DateTime?
  lastUpdateType   String?
  pendingUpdates   Int       @default(0)
  lastWebhookError String?
  starBalance      Int?
  balanceSyncedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  updates      TelegramUpdate[]
  transactions StarTransaction[]

  @@unique([organizationId, mode])
  @@unique([telegramBotId, mode])
  @@map("bot")
}

model ApiKey {
  id             String    @id
  organizationId String
  mode           Mode
  name           String
  prefix         String
  hash           String    @unique
  last4          String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([organizationId, mode])
  @@map("api_key")
}

model Product {
  id             String        @id
  organizationId String
  mode           Mode
  lookupKey      String?
  name           String
  description    String
  photoUrl       String?
  priceStars     Int
  type           ProductType
  periodSeconds  Int?
  status         ProductStatus @default(active)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@unique([organizationId, mode, lookupKey])
  @@index([organizationId, mode, status])
  @@map("product")
}

model Customer {
  id             String    @id
  organizationId String
  mode           Mode
  telegramUserId BigInt
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String?
  totalSpent     Int       @default(0)
  orderCount     Int       @default(0)
  lastPaymentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders        Order[]
  subscriptions Subscription[]

  @@unique([organizationId, mode, telegramUserId])
  @@index([organizationId, mode, totalSpent(sort: Desc)])
  @@map("customer")
}

model Order {
  id                String      @id
  organizationId    String
  mode              Mode
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  customerId        String?
  customer          Customer?   @relation(fields: [customerId], references: [id])
  /// If set, pre-checkout rejects any other payer.
  payerTelegramId   BigInt?
  amountStars       Int
  title             String
  description       String
  status            OrderStatus @default(created)
  failureReason     String?
  merchantReference String?
  metadata          Json        @default("{}")
  invoiceLink       String?
  expiresAt         DateTime
  paidAt            DateTime?
  refundedAt        DateTime?
  apiKeyId          String?
  /// Bot that issued the invoice; Telegram updates are matched on it.
  botId             String?
  settlement        Settlement  @default(direct)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  payments     Payment[]
  events       OrderEvent[]
  subscription Subscription?

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([organizationId, mode, status])
  @@index([status, expiresAt])
  @@index([organizationId, mode, merchantReference])
  @@index([botId])
  @@map("order")
}

model Payment {
  id                    String        @id
  organizationId        String
  mode                  Mode
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  /// telegram_payment_charge_id: the idempotency guard for successful_payment.
  telegramChargeId      String        @unique
  amountStars           Int
  isRecurring           Boolean       @default(false)
  isFirstRecurring      Boolean       @default(false)
  subscriptionExpiresAt DateTime?
  refundedAt            DateTime?
  raw                   Json
  settlement            Settlement    @default(direct)
  /// Platform settlement only: StarPay's fee and the merchant's share (amountStars - feeStars).
  feeStars              Int           @default(0)
  netStars              Int?
  feePlanId             String?
  /// When the net amount moves from pending to available (payment + hold period).
  availableAt           DateTime?
  releasedAt            DateTime?
  createdAt             DateTime      @default(now())

  @@index([orderId])
  @@index([settlement, releasedAt, availableAt])
  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@map("payment")
}

model Subscription {
  id               String             @id
  organizationId   String
  mode             Mode
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id])
  orderId          String             @unique
  order            Order              @relation(fields: [orderId], references: [id])
  /// Charge ID of the first payment; editUserStarSubscription needs it.
  firstChargeId    String
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments Payment[]

  @@index([organizationId, mode, status])
  @@index([status, currentPeriodEnd])
  @@map("subscription")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_event")
}

model TelegramUpdate {
  id           String    @id @default(cuid())
  botId        String
  bot          Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  updateId     BigInt
  type         String
  payload      Json
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  processingMs Int?
  error        String?

  @@unique([botId, updateId])
  @@index([botId, receivedAt(sort: Desc)])
  @@map("telegram_update")
}

model WebhookEndpoint {
  id                  String         @id
  organizationId      String
  mode                Mode
  url                 String
  description         String?
  /// Empty array = subscribed to every event.
  events              String[]
  status              EndpointStatus @default(active)
  secretEncrypted     String
  prevSecretEncrypted String?
  prevSecretExpiresAt DateTime?
  secretRotatedAt     DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  deliveries WebhookDelivery[]

  @@index([organizationId, mode])
  @@map("webhook_endpoint")
}

model WebhookEvent {
  id             String   @id
  organizationId String
  mode           Mode
  type           String
  orderId        String?
  data           Json
  createdAt      DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("webhook_event")
}

model WebhookDelivery {
  id             String          @id
  eventId        String
  event          WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         DeliveryStatus  @default(pending)
  attempts       Int             @default(0)
  maxAttempts    Int             @default(5)
  nextAttemptAt  DateTime        @default(now())
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastLatencyMs  Int?
  lastError      String?
  lastResponse   String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  attemptLog WebhookAttempt[]

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("webhook_delivery")
}

model WebhookAttempt {
  id         String          @id @default(cuid())
  deliveryId String
  delivery   WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempt    Int
  statusCode Int?
  latencyMs  Int?
  error      String?
  response   String?
  createdAt  DateTime        @default(now())

  @@index([deliveryId])
  @@map("webhook_attempt")
}

model StarTransaction {
  id           String   @id @default(cuid())
  botId        String
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramTxId String
  /// Signed: positive = incoming, negative = outgoing.
  amount       Int
  kind         String
  orderId      String?
  date         DateTime
  raw          Json

  @@unique([botId, telegramTxId])
  @@index([botId, date(sort: Desc)])
  @@map("star_transaction")
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  organizationId String
  mode           Mode
  key            String
  requestHash    String
  statusCode     Int
  response       Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, mode, key])
  @@index([createdAt])
  @@map("idempotency_record")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  mode           Mode?
  actorType      String
  actorId        String
  action         String
  targetId       String?
  data           Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// Commission and payout terms. One plan is the default; merchants can be assigned another.
model FeePlan {
  id             String   @id
  name           String
  /// Commission in basis points of each payment (500 = 5%).
  percentBps     Int
  /// Flat commission per payment, in Stars.
  fixedStars     Int      @default(0)
  /// Charged per payout, in Stars (covers TON network fees).
  payoutFeeStars Int      @default(0)
  minPayoutStars Int      @default(1000)
  /// Days a payment stays pending before it can be withdrawn (Telegram holds Stars ~21 days).
  holdDays       Int      @default(21)
  /// Rolling reserve: this share of the last `reserveDays` of released earnings can't be withdrawn.
  reserveBps     Int      @default(0)
  reserveDays    Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchants MerchantSettings[]

  @@map("fee_plan")
}

/// Double-entry ledger (Stars). Balances are always SUM(ledger_entry.amount);
/// entries are append-only and every transaction sums to zero (enforced by triggers).
model LedgerAccount {
  id             String            @id
  mode           Mode
  type           LedgerAccountType
  /// Merchant organization, or "platform" for StarPay's own accounts.
  organizationId String
  createdAt      DateTime          @default(now())

  entries LedgerEntry[]

  @@unique([mode, type, organizationId])
  @@map("ledger_account")
}

model LedgerTransaction {
  id             String   @id
  mode           Mode
  /// payment | release | refund | payout_request | payout_paid | payout_reversed | fragment_withdrawal | adjustment
  type           String
  /// Merchant the transaction concerns, if any.
  organizationId String?
  paymentId      String?
  payoutId       String?
  description    String
  /// e.g. "payment:pay_…"; makes posting idempotent.
  idempotencyKey String   @unique
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  entries LedgerEntry[]

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([paymentId])
  @@index([payoutId])
  @@map("ledger_transaction")
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  /// Signed Stars: positive = debit, negative = credit.
  amount        Int
  createdAt     DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entry")
}

model Payout {
  id             String       @id
  organizationId String
  mode           Mode
  amountStars    Int
  feeStars       Int
  status         PayoutStatus @default(requested)
  tonAddress     String
  /// Conversion used when sent: USD per Star and USD per TON.
  starUsdRate    Float?
  tonUsdRate     Float?
  tonAmountNano  BigInt?
  /// Wallet seqno reserved for the transfer; makes automatic sending replay-safe.
  walletSeqno    Int?
  txReference    String?
  failureReason  String?
  requestedById  String
  processedById  String?
  createdAt      DateTime     @default(now())
  sentAt         DateTime?
  paidAt         DateTime?
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, mode, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("payout")
}
